{
  "name": "reolink-app-card",
  "version": "0.2.1",
  "private": true,
  "description": "Lovelace card for Reolink cameras on a Reolink Home Hub",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:browser": "node --test --test-concurrency=1 \"test/browser/*.test.js\"",
    "check": "npm run build && npm test && npm run test:browser"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.63.0"
  }
}
